open! Ppxlib
open! Stdppx

type t =
  { constr : longident loc
  ; arg : pattern * expression
  (** A pattern and expression to use for the argument to the box/unbox functions, e.g.
      for
      {[
        type t = Foo.t [@@deriving box]
      ]}
      this is the [x] in
      {[
        let box : 'a. 'a t# -> 'a t = fun x -> Foo.box x
      ]}

      This symbol should be generated by the expansion driver, so that it can be shared
      between the boxed and unboxed versions. *)
  }

include Expander.S with type t := t
