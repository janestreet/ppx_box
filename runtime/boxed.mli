@@ stateless

(** An [('a, 'b) t] is a witness that ['a] _boxes_ ['b]. That is, a value of type ['a] is
    represented in memory as an OCaml block, with a valid header, containing a single
    ['b].

    In particular, for any record type [r] and implicit unboxed record type [r#], it is
    possible to produce a [(r, r#) t], serving as a witness that [r] boxes [r#].

    For most types, one should use ppx_box to obtain a witness, e.g.
    {[
      type r =
        { fst : f64
        ; snd : i64
        }
      [@@deriving_inline box]

      val box : r# @ l -> r @ l
      [@@alloc a @ l = (heap @ global, stack @ local)] [@@zero_alloc_if_stack a]

      val unbox : r @ l -> r# @ l [@@mode l = (global, local)] [@@zero_alloc]
      val boxed : unit -> (r, r#) Ox.Boxed.t [@@zero_alloc]

      [@@@end]
    ]}

    In the future, we expect OxCaml to have a built-in type constructor [(_ : any) box],
    such that the type equality [r = r# box] holds. *)
type ('a : value, 'b : any) t : void

(** Think twice about calling this yourself! Most instances of [t] should be generated by
    ppx_box. Just because it is _possible_ to implement [box] and [unbox] for two types
    does NOT necessarily mean that it is safe to create a witness for them.

    In particular, it would be a mistake to create a witness for any types generated via
    [ppx_unboxed_variant], or for basically all of the unboxed number types! *)
external magic_create : ('a : value) ('b : any). unit# -> ('a, 'b) t = "%identity"
